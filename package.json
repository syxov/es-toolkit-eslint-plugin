{
  "name": "es-toolkit-eslint-plugin",
  "version": "0.1.4",
  "description": "ESLint plugin that suggests es-toolkit utilities in place of verbose JS/TS",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "docs",
    "README.md"
  ],
  "keywords": [
    "eslint",
    "eslintplugin",
    "eslint-plugin",
    "es-toolkit"
  ],
  "license": "MIT",
  "author": "Aliaksandr Zasim",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/syxov/es-toolkit-eslint-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/syxov/es-toolkit-eslint-plugin/issues"
  },
  "homepage": "https://github.com/syxov/es-toolkit-eslint-plugin#readme",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "typecheck": "tsc",
    "format": "prettier --write . --experimental-cli --log-level=error",
    "format:check": "prettier --check . --experimental-cli --log-level=warn",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test",
    "prepublishOnly": "pnpm run check && pnpm run build",
    "release": "pnpm publish --access public"
  },
  "dependencies": {
    "@typescript-eslint/utils": "^8.73.0"
  },
  "peerDependencies": {
    "eslint": ">=10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "@typescript-eslint/parser": "^8.73.0",
    "@typescript-eslint/rule-tester": "^8.73.0",
    "@vitest/eslint-plugin": "^1.6.28",
    "eslint": "^10.15.0",
    "eslint-plugin-eslint-plugin": "^7.6.2",
    "prettier": "^3.10.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vitest": "^5.1.1"
  }
}
